# Скопируйте в .env. Без ключа справочник работает, ассистент отвечает 503.
ASSISTANT_PROVIDER=runpod
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=b1dd8hy2hqo1nb
RUNPOD_MODEL=glm-5.3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
SESSION_SECRET=
EMBEDDING_URL=http://embeddings:8080/v1/embeddings

# Боты включаются профилями Compose; токены добавьте перед запуском.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=https://example.org/webhooks/max
MAX_WEBHOOK_SECRET=
# Внешний адрес портала для ссылок в ответах ботов.
PORTAL_PUBLIC_URL=https://example.org
